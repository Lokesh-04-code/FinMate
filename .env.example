# FinMate Frontend Environment Variables
# In Vite, client-exposed variables must be prefixed with VITE_

# Backend URL (use http://localhost:5000 for local dev, or your Render backend URL for production)
VITE_BACKEND_URL=https://backendfinmate.onrender.com

# Google OAuth 2.1 / OIDC Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=
