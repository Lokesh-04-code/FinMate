# FinMate Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# MongoDB connection string (Atlas or local)
CONNECTION_STRING=mongodb+srv://<user>:<password>@cluster.mongodb.net/finmate?retryWrites=true&w=majority

# JWT secrets — generate with: node -e "require('crypto').randomBytes(64).toString('hex')|Write-Host"
# Use DIFFERENT secrets for access and refresh tokens!
ACCESS_TOKEN_SECRET=your_long_random_access_token_secret_here
REFRESH_TOKEN_SECRET=your_long_random_refresh_token_secret_here

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# "production" or "development"
NODE_ENV=development

# Server port (Render sets this automatically)
PORT=5000

# Google OAuth 2.1 / OIDC Configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://backendfinmate.onrender.com/api/auth/google/callback
FRONTEND_URL=https://your-frontend.onrender.com
